{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transcribe-audio.mail-relationship-hypothesis.v1",
  "title": "Deterministic Mail Relationship Or Role Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "hypothesis_id", "hypothesis_kind", "relationship_type",
    "directionality", "subject_contact_id", "counterpart_type",
    "counterpart_id", "counterpart_label", "evidence_observation_ids",
    "evidence_independence_group_ids", "observation_count",
    "independent_thread_count", "first_observed_at", "last_observed_at",
    "status", "basis", "why_not_accepted", "conflicts", "effect_counts"
  ],
  "properties": {
    "schema_version": {"const": "transcribe-audio.mail-relationship-hypothesis.v1"},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "hypothesis_kind": {"enum": ["sent_mail", "correspondence", "thread_coparticipation", "contextual_role", "affiliation"]},
    "relationship_type": {"enum": ["SENT_MAIL_TO", "CORRESPONDED_WITH", "MAIL_THREAD_COPARTICIPANT_WITH", "HAS_CONTEXTUAL_ROLE", "AFFILIATED_WITH"]},
    "directionality": {"enum": ["directional", "symmetric"]},
    "subject_contact_id": {"type": "string", "minLength": 1},
    "counterpart_type": {"enum": ["contact_candidate", "organization", "contextual_role"]},
    "counterpart_id": {"type": "string", "minLength": 1},
    "counterpart_label": {"type": "string", "minLength": 1},
    "evidence_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_independence_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observation_count": {"type": "integer", "minimum": 1},
    "independent_thread_count": {"type": "integer", "minimum": 1},
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "proposed"},
    "basis": {"type": "string", "minLength": 1},
    "why_not_accepted": {"type": "string", "minLength": 1},
    "conflicts": {"type": "array"},
    "effect_counts": {"type": "object"}
  }
}
